<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameWebBrowser</AssemblyName><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>2.0.0</Version><NoWarn>$(NoWarn);MSB3246</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Modules/GameWebBrowser.cs" /><Compile Include="CefIntegration.cs" />
    <Reference Include="$(OmniLibPath)/*.dll"><Private>false</Private></Reference>
    <Reference Include="$(DalamudLibPath)/*.dll"><Private>false</Private></Reference>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
</Project>
